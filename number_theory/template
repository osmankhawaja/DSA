const int M=1e18+7;
const double eps=1e-8;
const int N=1e7;
vector<int>prime;

///modular multiplicative inverse
int inv(int a, int b, int M) //b=M-2
{
    int res=1;
    while(b)
    {
        if(b & 1)
        {
            res=(res*a)%M;
        }
        a=(a*a)%M;
        b>>=1;
    }
    return res;
}

///recursive approach of binary exponentiation
///O(log n)
int bin_expI(int a, int b)
{
    if(b==0) return 1;
    int res=bin_expI(a, b/2);
    if(b&1)   return (a*((res%M)*(res%M)))%M;
    else   return (((res)%M)*(res%M))%M;
}

///iterative approach of binary exponentiation
///O(log n)
int power(int a, int b)
{
    int res=1;
    while(b)
    {
        if(b & 1)
        {
            res=(res*a)%M;
        }
        a=(a*a)%M;
        b>>=1;
    }
    return res;
}

int mul(int a, int b)
{
    return ((a%M)*(b%M))%M;
}

///factorial
///O(n)
int fact(int n)
{
    if(n==0 || n==1)  return 1;
    else  return (n * 1LL * fact(n-1)) % M;
}

///GCD
int gcd(int a,int b)
{
    if(b == 0) return a;
    return  gcd(b, a%b);
}

///LCM
int lcm(int a, int b)
{
    return (a*b)/ gcd(a, b);
}

///binary representation
void print_binary(int n)
{
    for(int i=8; i>=0; i--)
    {
        cout<<((n>>i)&1);
    }
    cout<<endl;
}

void seive()
{
    vector<bool>v(N);
    v[0]=false;
    v[1]=false;
    for(int i=2; i*i<=N; i++)
    {
        for(int j=i*i; j<=N; j+=i)
        {
            v[j]=false;
        }
    }
    for(int i=1; i<=N; i++)
    {
        if(v[i] == true)prime.push_back(i);
    }
}

///fibonacci number
int fibo(int a)
{
    if(a==1 || a==2) return 1;
    return fibo(a-1) + fibo(a-2);
}

